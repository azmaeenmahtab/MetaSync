# --- Meta App Credentials ---
# Get these from: https://developers.facebook.com → Your App → Settings → Basic

# A secret string YOU choose (any random text, e.g. "my_secret_token_123")
# You'll enter the exact same string in the Meta Webhook settings page
WEBHOOK_VERIFY_TOKEN=my_secret_verify_token

# Your Page Access Token — needed to fetch actual lead details from Meta's Graph API
# Get this from: Meta Developer Dashboard → Your App → Tools → Graph API Explorer
# Select your Page, generate a Page Access Token with ads_management + leads_retrieval permissions
META_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Server ports
HTTP_PORT=3001
WS_PORT=3002
